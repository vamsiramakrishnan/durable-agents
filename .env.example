# Tape — local-development environment.
#
# Copy to .env:    cp .env.example .env
# Loaded by:       make dev, make demo, docker compose, the Python SDK & CLI.
#
# All TAPE_* vars also work as flags (--listen, --store, --url) on the server
# and the Python CLI.

# ── tape-server ────────────────────────────────────────────────

# Where the server listens.
TAPE_LISTEN=127.0.0.1:7878

# Where runs are persisted. The URL scheme picks the backend — nothing above
# the server changes when you switch it.
#
#   sqlite:./tape.db                    file-backed SQLite (default; single node)
#   sqlite::memory:                     ephemeral in-process (tests, demos)
#   postgres://user:pass@host:5432/db   PostgreSQL (horizontally scalable)
#   alloydb://user:pass@host:5432/db    AlloyDB (Postgres-wire-compatible)
#   bigtable://project/instance/table   Cloud Bigtable
#
TAPE_STORE=sqlite:./tape.db

# Rust log filter. `tape_server=debug,tower_http=info` is a useful starting
# point when something is acting up.
RUST_LOG=tape_server=info

# Lease TTL for the per-run driver lease. The demo-resume recipe sets this
# very short (1500ms) so the recovery driver wins quickly after a crash;
# production typically wants 10s+.
# TAPE_LEASE_MS=10000

# ── SDK / agent process ────────────────────────────────────────

# Where the SDK connects.
#   tape://host:port    plaintext
#   tapes://host:port   TLS + Google ID-token (for Cloud Run, etc.)
TAPE_URL=tape://127.0.0.1:7878

# ── Postgres (only if TAPE_STORE points at postgres) ───────────

# Picked up by docker-compose.yml.
POSTGRES_USER=tape
POSTGRES_PASSWORD=tape
POSTGRES_DB=tape

# ── Bigtable (only if TAPE_STORE points at bigtable) ───────────

# When set, the SQL/Bigtable client talks to the emulator instead of GCP.
# BIGTABLE_EMULATOR_HOST=127.0.0.1:8086

# ── Examples ───────────────────────────────────────────────────

# Where the treasury example writes its bank ledger.
# TAPE_EXAMPLE_DIR=/tmp/tape-demo-ledgers

# When set, the treasury example crashes after the named tool fires once —
# the demo-resume recipe uses this to prove kill-and-resume.
# TAPE_CRASH_AFTER=execute_sweep
