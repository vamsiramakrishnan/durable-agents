{
  "name": "tape-ts",
  "version": "0.1.0",
  "description": "Tape — a durable-execution substrate for ADK agents (TypeScript SDK).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
