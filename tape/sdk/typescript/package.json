{
  "name": "tape-ts",
  "version": "0.1.0",
  "description": "Tape — a durable-execution substrate for ADK agents (TypeScript SDK).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./embedded": "./src/embedded/index.ts"
  },
  "files": [
    "src",
    "proto",
    "bin"
  ],
  "bin": {
    "tape-outbox-ts": "bin/tape-outbox-ts.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts",
    "test:embedded": "node --test --experimental-strip-types --no-warnings test/embedded.test.ts",
    "outbox": "node --experimental-strip-types --no-warnings bin/tape-outbox-ts.ts",
    "regen-proto": "cp ../../proto/tape.proto ./proto/tape.proto"
  },
  "optionalDependencies": {
    "@google-cloud/pubsub": "^4.7.0",
    "better-sqlite3": "^11.0.0",
    "google-auth-library": "^9.0.0",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": { "optional": true },
    "pg": { "optional": true }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.6",
    "@grpc/proto-loader": "^0.7.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "better-sqlite3": "^12.10.0",
    "typescript": "^6.0.3"
  }
}
